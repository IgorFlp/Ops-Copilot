{
  "chat.tools.terminal.autoApprove": {
    "npm run": true,
    "npx tsc": true,
    "node": true,
    "git status": true,
    "git diff": true,
    "git add": true,
    "git commit": true,
    "/(?:^|[;&|]\\s*)rm\\s+-rf\\b/i": {
      "approve": false,
      "matchCommandLine": true
    },
    "/(?:^|[;&|]\\s*)sudo\\b/i": {
      "approve": false,
      "matchCommandLine": true
    },
    "/(?:^|[;&|]\\s*)git\\s+push\\b.*(?:--force(?:-with-lease)?|-f)(?:\\s|$)/i": {
      "approve": false,
      "matchCommandLine": true
    },
    "/\\.env(?:$|[\\s\"';&|,)])/i": {
      "approve": false,
      "matchCommandLine": true
    }
  }
}

{
  "name": "ops-pilot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "predev": "npm run seed",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "arena": "node --env-file-if-exists=.env --import tsx src/arena.ts",
    "db:migrate:alert-severity": "node --env-file-if-exists=.env --import tsx scripts/migrate-alert-severity.ts",
    "bench": "node --env-file-if-exists=.env --import tsx src/bench.ts",
    "test": "node --import tsx --test src/**/*.test.ts scripts/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "latest",
    "@langchain/langgraph": "latest",
    "@langchain/openai": "latest",
    "express": "latest",
    "pg": "latest",
    "sequelize": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/sequelize": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
